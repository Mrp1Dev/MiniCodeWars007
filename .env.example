# Copy to .env and fill in. Real environment variables override this file.

# --- AI "clean code" (Featherless, OpenAI-compatible) ---
MCW_AI_API_KEY=
MCW_AI_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
MCW_AI_BASE_URL=https://api.featherless.ai/v1
# Max tokens per answer. Thinking model: the thinking counts too, so too low gives empty
# answers (the most seen in testing was ~1600).
MCW_AI_MAX_TOKENS=6000
MCW_AI_TIMEOUT_S=120
# Requests sent to the AI at the same time. Featherless limits concurrent requests
# per plan; set this to what your plan allows. Extra requests wait in a queue.
MCW_AI_CONCURRENCY=10
# Per participant: cleanups per minute, and in total.
MCW_AI_PER_MINUTE=4
MCW_AI_MAX_PER_PARTICIPANT=60
# Hard spending caps in output-equivalent tokens (output + input/2). Each request reserves its
# worst case (MCW_AI_MAX_TOKENS + its input) first, so these can't be overshot.
MCW_AI_TOKEN_BUDGET=70000000
MCW_AI_TOKENS_PER_PARTICIPANT=100000

# --- server ---
# Leave empty to generate one into data/admin_key.txt on first start.
MCW_ADMIN_KEY=
# MCW_DB=data/minicodewars.db
# MCW_MAX_PARALLEL_MATCHES=14
# MCW_CORS_ORIGINS=*
